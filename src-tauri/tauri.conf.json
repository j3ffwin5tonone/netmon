{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "netmon",
  "version": "0.2.1",
  "identifier": "com.andi.netmon",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "netmon",
        "width": 800,
        "height": 600,
        "visible": false,
        "skipTaskbar": true,
        "label": "main",
        "minWidth": 360,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright (c) 2026 Andreas Distel",
    "resources": {
      "../LICENSE": "LICENSE",
      "../static/licenses.html": "licenses.html",
      "../static/legal-sources/": "legal-sources/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
